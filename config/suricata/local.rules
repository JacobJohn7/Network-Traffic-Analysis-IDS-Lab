# local.rules - Custom Suricata NIDS Detection Rules
# Lab Environment: Ubuntu Server 24.04 LTS (192.168.56.106)
# Author: Jacob John
# Description: Custom signature set created for local network security monitoring testing.

# 1. Web Shell / Command Injection Attempt Detection
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"LOCAL SURICATA HTTP Suspicious Command Injection Attempt"; flow:established,to_server; content:"cmd.php"; nocase; content:"cmd="; nocase; classtype:web-application-attack; sid:1000001; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"LOCAL SURICATA HTTP Path Traversal Attempt Detected"; flow:established,to_server; content:"../.."; classtype:web-application-attack; sid:1000002; rev:1;)

# 2. SSH Brute Force Threshold Alert
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"LOCAL SURICATA SSH Potential Brute Force Attempt"; flow:established,to_server; flags:S; threshold: type threshold, track by_src, count 10, seconds 60; classtype:attempted-recon; sid:1000003; rev:1;)

# 3. Reconnaissance / Nmap SYN Scan Detection
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"LOCAL SURICATA RECON Nmap Stealth SYN Scan Detected"; flags:S,12; window:1024; classtype:attempted-recon; sid:1000004; rev:1;)

# 4. Outbound Traffic to Suspicious Non-Standard Ports
alert tcp $HOME_NET any -> $EXTERNAL_NET !443 (msg:"LOCAL SURICATA Outbound Unencrypted Shell or Proxy Port 4444"; flow:to_server; dst_port:4444; classtype:trojan-activity; sid:1000005; rev:1;)

# 5. Sensitive File Access Attempt (.env / config exposure)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"LOCAL SURICATA HTTP Request for Sensitive Environment File"; flow:established,to_server; content:".env"; nocase; classtype:attempted-recon; sid:1000006; rev:1;)

# 6. Log4j / Log4Shell JNDI Exploit Injection Attempt (CVE-2021-44228)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"LOCAL SURICATA EXPLOIT Log4j JNDI Exploit Attempt in HTTP Headers/URI (CVE-2021-44228)"; flow:established,to_server; content:"${jndi:"; nocase; fast_pattern; reference:cve,2021-44228; reference:url,cve.mitre.org/cgi-bin/cvename.cgi?name=CVE-2021-44228; classtype:attempted-admin; sid:1000007; rev:1;)

# 7. Spring4Shell Remote Code Execution Payload (CVE-2022-22965)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"LOCAL SURICATA EXPLOIT Spring4Shell ClassLoader Access Pattern (CVE-2022-22965)"; flow:established,to_server; content:"class.module.classLoader"; nocase; fast_pattern; reference:cve,2022-22965; classtype:attempted-admin; sid:1000008; rev:1;)

# 8. Web Reconnaissance - Automated Vulnerability Scanner User-Agent Probing
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"LOCAL SURICATA RECON Automated Security Scanner User-Agent Detected (Nikto/Sqlmap)"; flow:established,to_server; http.user_agent; content:"Nikto"; nocase; classtype:attempted-recon; sid:1000009; rev:1;)

# 9. Atlassian Confluence OGNL Injection Remote Code Execution (CVE-2022-26134)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"LOCAL SURICATA EXPLOIT Atlassian Confluence OGNL Injection In URI (CVE-2022-26134)"; flow:established,to_server; http.uri; content:"%24%7B"; nocase; content:"%40"; nocase; content:"getEngineByName"; nocase; fast_pattern; reference:cve,2022-26134; reference:url,cve.mitre.org/cgi-bin/cvename.cgi?name=CVE-2022-26134; classtype:attempted-admin; sid:1000010; rev:1;)

# 10. Palo Alto PAN-OS GlobalProtect Command Injection Probe (CVE-2024-3400)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"LOCAL SURICATA EXPLOIT Palo Alto PAN-OS GlobalProtect Arbitrary File Creation (CVE-2024-3400)"; flow:established,to_server; http.uri; content:"/ssl-vpn/hipreport.esp"; fast_pattern; http.header; content:"SESSID=../../"; nocase; reference:cve,2024-3400; reference:url,cve.mitre.org/cgi-bin/cvename.cgi?name=CVE-2024-3400; classtype:web-application-attack; sid:1000011; rev:1;)

# 11. Apache HTTPD Path Traversal and RCE (CVE-2021-41773)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"LOCAL SURICATA EXPLOIT Apache HTTPD Path Traversal and RCE (CVE-2021-41773)"; flow:established,to_server; http.uri; content:"/icons/"; nocase; content:".."; classtype:web-application-attack; reference:cve,2021-41773; sid:1000012; rev:1;)

# 12. SAP NetWeaver Visual Composer Unauthenticated Metadata Uploader (CVE-2025-31324)
# Public exploit chains POST a JSP webshell to the unauthenticated metadatauploader servlet.
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"LOCAL SURICATA EXPLOIT SAP NetWeaver Visual Composer Metadata Uploader Unauthenticated File Upload (CVE-2025-31324)"; flow:established,to_server; http.uri; content:"/developmentserver/metadatauploader"; nocase; fast_pattern; reference:cve,2025-31324; reference:url,nvd.nist.gov/vuln/detail/CVE-2025-31324; classtype:web-application-attack; sid:1000014; rev:1;)

# 13. Apache Tomcat Partial PUT Write-Enabled Default Servlet RCE Probe (CVE-2025-24813)
# Exploitation issues a chunked PUT with a Content-Range header to stage a serialized session payload.
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"LOCAL SURICATA EXPLOIT Apache Tomcat Partial PUT Session Deserialization RCE Probe (CVE-2025-24813)"; flow:established,to_server; http.method; content:"PUT"; http.header; content:"Content-Range:"; nocase; reference:cve,2025-24813; reference:url,nvd.nist.gov/vuln/detail/CVE-2025-24813; classtype:web-application-attack; sid:1000015; rev:1;)

# 14. Next.js Middleware Authorization Bypass via x-middleware-subrequest Header (CVE-2025-29927)
# Next.js trusts the internal x-middleware-subrequest header from any client; a value with a
# repeating middleware stack (middleware:middleware:middleware:middleware:middleware) causes the
# middleware chain to short-circuit, skipping auth checks and exposing protected routes.
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"LOCAL SURICATA EXPLOIT Next.js Middleware Authorization Bypass x-middleware-subrequest Header (CVE-2025-29927)"; flow:established,to_server; http.header; content:"x-middleware-subrequest|3a|"; nocase; fast_pattern; content:"middleware:middleware"; nocase; reference:cve,2025-29927; reference:url,nvd.nist.gov/vuln/detail/CVE-2025-29927; classtype:attempted-admin; sid:1000016; rev:1;)

# 15. Apache ActiveMQ OpenWire Deserialization RCE Probe (CVE-2023-46604)
# The OpenWire marshaller deserializes an ExceptionResponse on TCP/61616. The exploit class
# org.springframework.context.support.ClassPathXmlApplicationContext is pulled in via the
# BaseDataStreamMarshaller payload. Flag the class name and the OpenWire hex magic (4e4d / "NM").
alert tcp $EXTERNAL_NET any -> $HOME_NET 61616 (msg:"LOCAL SURICATA EXPLOIT Apache ActiveMQ OpenWire Deserialization RCE (CVE-2023-46604)"; flow:established,to_server; content:"|00 00 00 00|"; depth:4; content:"ClassPathXmlApplicationContext"; nocase; distance:0; reference:cve,2023-46604; reference:url,nvd.nist.gov/vuln/detail/CVE-2023-46604; classtype:attempted-admin; sid:1000017; rev:1;)
